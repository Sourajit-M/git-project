# Server Port
PORT=8080
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://gitai_user:gitai_password@localhost:5432/gitai_db?schema=public"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# Groq Cloud AI API Key (Get free key from https://console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# GitHub OAuth App Credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:8080/api/v1/auth/github/callback"

# JWT Secret for Session Management
JWT_SECRET="gitai-super-secret-jwt-key-2026-secure"
FRONTEND_URL="http://localhost:3000"
